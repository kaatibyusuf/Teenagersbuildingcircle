  Seerah: { title: 'Seerah - Final Exam (Th\u0101niy Ibtid\u0101\u2019iyyah)', start: '2027-01-24T09:00', qs: [{"kind": "S", "q": "قال طالب إن أبا جهل أسلم يوم حمزة. صحح:", "A": "هاجر", "B": "أسلم", "C": "نصر النبي", "D": "لم يسلم أبو جهل", "c": "D", "pen": 0, "exp": "مات كافرًا."}, {"kind": "S", "q": "قال طالب: ردّ النبي ﷺ على عمه بقوله «لو وضعوا الشمس في يميني». ماذا يستفاد؟", "A": "قبول عروض المال", "B": "التراجع عن الدعوة", "C": "الاستسلام", "D": "الثبات على الدين وعدم المساومة", "c": "D", "pen": 0, "exp": "ثبات."}, {"kind": "N", "q": "أيُّ العبارات الآتية صحيحة؟", "A": "سألوا النصارى فقط", "B": "ذهبوا إلى الروم", "C": "طلب وفد قريش من أحبار اليهود ما يمتحنون به النبي ﷺ", "D": "اتبعوا النبي ﷺ", "c": "C", "pen": 0.25, "exp": "الروح والكهف وذو القرنين."}, {"kind": "M", "q": "قال أبو بكر حين أراد عقبة خنق النبي ﷺ بردائه:", "A": "«اتركوه»", "B": "«أتقتلون رجلًا أن يقول ربي الله»", "C": "«إنه ساحر» في سياق النص في سياق النص", "D": "«اقتلوه»", "c": "B", "pen": 0, "exp": "دفاع الصديق."}, {"kind": "S", "q": "قال طالب: أسلم عمر فشدّ الله به الإسلام. ما معنى ذلك؟", "A": "هاجروا كلهم", "B": "قويت شوكة المسلمين وجهروا بالعبادة", "C": "ضعف المسلمون في هذا الموضع كما يظنّ بعض الدارسين", "D": "سكتوا", "c": "B", "pen": 0, "exp": "عز الإسلام."}, {"kind": "N", "q": "أيُّ العبارات الآتية صحيحة؟", "A": "قرأ جعفر على النجاشي صدرًا من سورة مريم", "B": "قرأ الكهف", "C": "قرأ يس", "D": "قرأ البقرة بحسب فهم بعضهم كما يظنّ بعض الدارسين", "c": "A", "pen": 0.25, "exp": "فبكى النجاشي."}, {"kind": "M", "q": "خرج عمر رضي الله عنه يريد:", "A": "الصلاة", "B": "قتل النبي ﷺ", "C": "السفر إلى الشام", "D": "التجارة", "c": "B", "pen": 0, "exp": "ثم أسلم."}, {"kind": "S", "q": "أيُّ الصحابيات كانت أول شهيدة في الإسلام؟", "A": "خديجة", "B": "أسماء", "C": "فاطمة", "D": "سمية", "c": "D", "pen": 0, "exp": "قتلها أبو جهل."}, {"kind": "S", "q": "من أيّ قبيلة كان حمزة وأبو طالب؟", "A": "بنو تيم", "B": "بنو هاشم", "C": "بنو مخزوم", "D": "بنو أمية", "c": "B", "pen": 0, "exp": "عمّا النبي ﷺ."}, {"kind": "N", "q": "أيُّ العبارات الآتية غيرُ صحيحة؟", "A": "لم يغره المال", "B": "رفض النبي ﷺ", "C": "لم يغره الملك", "D": "وافق النبي ﷺ على عرض قريش ليترك الدعوة", "c": "D", "pen": 0.25, "exp": "رفض."}, {"kind": "S", "q": "قال طالب إن النبي ﷺ اشتكى لعمه فلم ينصره. ما الصحيح؟", "A": "تركه", "B": "خذله", "C": "سلّمه", "D": "نصره أبو طالب وقال لا أسلمك لشيء أبدًا", "c": "D", "pen": 0, "exp": "نصر."}, {"kind": "M", "q": "طلب وفد قريش من أحبار اليهود سؤال النبي ﷺ عن:", "A": "الصيام والزكاة في سياق النص في سياق النص", "B": "الحج والعمرة", "C": "الروح وأصحاب الكهف وذي القرنين", "D": "القتال والسلم", "c": "C", "pen": 0, "exp": "فنزلت سورة الكهف."}, {"kind": "N", "q": "أيُّ العبارات الآتية غيرُ صحيحة؟", "A": "أسلم عمر عن حب للنبي ﷺ من أول لقاء", "B": "خرج عمر يريد قتل النبي ﷺ", "C": "سمع القرآن في بيت أخته", "D": "ثم أسلم", "c": "A", "pen": 0.25, "exp": "كان مبغضًا في البداية."}, {"kind": "S", "q": "عندما رأى حمزة النبي ﷺ يؤذى عند الصفا فعل ماذا؟", "A": "ضرب أبا جهل بقوسه وأسلم", "B": "تركه في سياق النص في سياق النص", "C": "سكت", "D": "هرب", "c": "A", "pen": 0, "exp": "حمية."}, {"kind": "M", "q": "من أول من جهر بالقرآن في مكة أمام قريش؟", "A": "عمر", "B": "عبد الله بن مسعود رضي الله عنه", "C": "علي", "D": "أبو بكر", "c": "B", "pen": 0, "exp": "فآذوه."}, {"kind": "M", "q": "اشتُهر عذاب خباب بن الأرت بـ:", "A": "النفي", "B": "الضرب بالسياط فقط", "C": "وضعه على الجمر الحامي", "D": "السجن في مكة", "c": "C", "pen": 0, "exp": "يُطفئ ظهره الجمر."}, {"kind": "M", "q": "من الذي اشترى بلالًا فأعتقه؟", "A": "عمر", "B": "علي", "C": "أبو بكر الصديق رضي الله عنه", "D": "عثمان", "c": "C", "pen": 0, "exp": "أعتق ما عُذّب في الله."}, {"kind": "M", "q": "قال النبي ﷺ لآل ياسر وهم يعذَّبون: ", "A": "ادعوا على قريش", "B": "اهجروا مكة", "C": "صبرًا آل ياسر فإن موعدكم الجنة", "D": "اتركوا دينكم", "c": "C", "pen": 0, "exp": "تثبيت."}, {"kind": "M", "q": "من هو الذي دعا له النبي ﷺ: «اللهم أعزّ الإسلام بأحب الرجلين إليك»؟", "A": "عمر بن الخطاب رضي الله عنه", "B": "عثمان", "C": "علي", "D": "أبو بكر بحسب فهم بعضهم في هذا الموضع", "c": "A", "pen": 0, "exp": "أو أبي جهل."}, {"kind": "N", "q": "أيُّ العبارات الآتية غيرُ صحيحة؟", "A": "نصر أبو طالب النبي ﷺ", "B": "مات على ملة عبد المطلب في سياق النص", "C": "أسلم أبو طالب وأعلن إيمانه", "D": "لم يسلّمه لقريش", "c": "C", "pen": 0.25, "exp": "لم يسلم."}, {"kind": "M", "q": "ما السورة التي كان يقرؤها خباب على فاطمة وزوجها حين دخل عمر؟", "A": "الفاتحة", "B": "طه", "C": "البقرة", "D": "الإخلاص", "c": "B", "pen": 0, "exp": "سمع أوائلها فأسلم."}, {"kind": "M", "q": "ما معنى «الشِّعب» في «شعب أبي طالب»؟", "A": "الصحراء الواسعة كما يظنّ بعض الدارسين", "B": "السوق", "C": "البحر", "D": "الطريق أو الوادي الضيق بين جبلين", "c": "D", "pen": 0, "exp": "مكان الحصار."}, {"kind": "N", "q": "أيُّ العبارات الآتية غيرُ صحيحة؟", "A": "هجرة الحبشة الثانية كانت قبل الأولى", "B": "الأولى في السنة الخامسة", "C": "في الثانية جعفر بن أبي طالب بحسب فهم بعضهم", "D": "الثانية بعد الأولى", "c": "A", "pen": 0.25, "exp": "الأولى قبل الثانية."}, {"kind": "M", "q": "من أسلم في السنة السادسة بعد أن ضرب أبا جهل بقوسه؟", "A": "أبو ذر", "B": "طلحة", "C": "حمزة بن عبد المطلب", "D": "عمر بن الخطاب", "c": "C", "pen": 0, "exp": "غضب لإيذاء النبي ﷺ."}, {"kind": "M", "q": "من أخت عمر التي أسلمت؟", "A": "فاطمة بنت الخطاب", "B": "أسماء بنت عميس", "C": "حفصة", "D": "أم سلمة", "c": "A", "pen": 0, "exp": "وزوجها سعيد بن زيد."}, {"kind": "N", "q": "أيُّ العبارات الآتية غيرُ صحيحة؟", "A": "حمى المسلمين", "B": "عدل الحاكم", "C": "أسلم النجاشي وأعاد المسلمين لقريش", "D": "ردّ هدايا قريش كما يظنّ بعض الدارسين", "c": "C", "pen": 0.25, "exp": "رد القرشيين."}, {"kind": "M", "q": "ما اسم ملك الحبشة الذي آوى المهاجرين؟", "A": "النجاشي (أصحمة)", "B": "هرقل", "C": "كسرى", "D": "المقوقس", "c": "A", "pen": 0, "exp": "عادل."}, {"kind": "N", "q": "أيُّ العبارات الآتية صحيحة؟", "A": "كانت معاهدة مع الروم بحسب فهم بعضهم في سياق النص", "B": "كانت صلحًا", "C": "كانت هدنة تجارة", "D": "كانت الصحيفة قطيعة على بني هاشم وبني المطلب", "c": "D", "pen": 0.25, "exp": "حصار."}, {"kind": "M", "q": "ما اسم العام الذي توفي فيه أبو طالب وخديجة رضي الله عنها قبل الهجرة؟", "A": "عام الوفود", "B": "عام الفتح", "C": "عام الفيل", "D": "عام الحزن", "c": "D", "pen": 0, "exp": "اشتد فيه الأذى."}, {"kind": "S", "q": "حين كُتبت الصحيفة قاطعت قريش:", "A": "بني هاشم وبني المطلب في البيع والزواج", "B": "الروم", "C": "الفرس", "D": "اليهود بحسب فهم بعضهم في هذا الموضع كما يظنّ بعض الدارسين", "c": "A", "pen": 0, "exp": "حصار."}, {"kind": "M", "q": "من هو الذي عرض على النبي ﷺ المال والملك والنساء ليترك دعوته؟", "A": "أبو لهب", "B": "عتبة بن ربيعة", "C": "عقبة بن أبي معيط", "D": "أبو جهل", "c": "B", "pen": 0, "exp": "ردّ عليه النبي ﷺ بسورة فصلت."}, {"kind": "M", "q": "من هي «حمّالة الحطب» التي آذت النبي ﷺ؟", "A": "خديجة", "B": "أم جميل امرأة أبي لهب", "C": "سمية", "D": "فاطمة بنت الخطاب", "c": "B", "pen": 0, "exp": "نزلت في السورة المسد."}, {"kind": "N", "q": "أيُّ العبارات الآتية غيرُ صحيحة؟", "A": "عُذّب عمار وأهله", "B": "عُذّب بلال وصبر", "C": "عُذّب الصحابة ولم يصبروا فارتدوا كلهم", "D": "عُذّب خباب", "c": "C", "pen": 0.25, "exp": "صبروا."}, {"kind": "N", "q": "أيُّ العبارات الآتية صحيحة؟", "A": "لم يخبره الله", "B": "أخبر الله نبيه بأن الأرضة أكلت الصحيفة", "C": "أكلتها النار", "D": "قطعها أبو لهب", "c": "B", "pen": 0.25, "exp": "وأخبر عمه أبا طالب."}, {"kind": "S", "q": "قال أحدهم إن الصحيفة بقيت كما كتبت. ما التصحيح؟", "A": "أكلت الأرضة ما فيها من ظلم وبقي ذكر الله", "B": "ضاعت", "C": "بقيت كاملة", "D": "أحرقها أبو لهب", "c": "A", "pen": 0, "exp": "معجزة."}, {"kind": "M", "q": "من أول من هاجر إلى الحبشة مع زوجته؟", "A": "عثمان بن عفان مع رقية بنت النبي ﷺ", "B": "جعفر مع أسماء في هذا الموضع بحسب فهم بعضهم", "C": "علي مع فاطمة", "D": "عمر مع زوجته", "c": "A", "pen": 0, "exp": "قال ﷺ إنهما أول بيت هاجر بعد لوط."}, {"kind": "M", "q": "ما مدة الحصار في الشعب؟", "A": "ثلاث سنوات تقريبًا", "B": "سبع سنوات", "C": "سنة واحدة", "D": "عشر سنوات", "c": "A", "pen": 0, "exp": "في الصحيفة."}, {"kind": "N", "q": "أيُّ العبارات الآتية صحيحة؟", "A": "أسلم عمر قبل حمزة", "B": "أسلما في اليوم نفسه بحسب 