  Seerah: { title: 'Seerah - Final Exam (Th\u0101lith Ibtid\u0101\u2019iyyah)', start: '2027-01-24T09:00', qs: [{"kind": "S", "q": "قال أحدهم إن الصحيفة بقيت كما كتبت. ما التصحيح؟", "A": "أحرقها أبو لهب بحسب فهم بعضهم في سياق النص", "B": "بقيت كاملة", "C": "ضاعت", "D": "أكلت الأرضة ما فيها من ظلم وبقي ذكر الله", "c": "D", "pen": 0, "exp": "معجزة."}, {"kind": "N", "q": "أيُّ العبارات الآتية غيرُ صحيحة؟", "A": "رفض النبي ﷺ", "B": "لم يغره المال بحسب فهم بعضهم في هذا الموضع", "C": "لم يغره الملك", "D": "وافق النبي ﷺ على عرض قريش ليترك الدعوة", "c": "D", "pen": 0.25, "exp": "رفض."}, {"kind": "N", "q": "أيُّ العبارات الآتية صحيحة؟", "A": "لم يسلم حمزة", "B": "أسلما في اليوم نفسه", "C": "أسلم حمزة قبل عمر رضي الله عنهما", "D": "أسلم عمر قبل حمزة", "c": "C", "pen": 0.25, "exp": "حمزة في السنة السادسة."}, {"kind": "M", "q": "قال النبي ﷺ لعمه: «والله لو وضعوا الشمس في يميني والقمر في يساري على أن أترك هذا الأمر ... »", "A": "لتركته", "B": "حتى يُظهره الله أو أهلك فيه ما تركته", "C": "لفكرت فيه", "D": "لسألت عمي", "c": "B", "pen": 0, "exp": "ثبات الرسول ﷺ."}, {"kind": "N", "q": "أيُّ العبارات الآتية صحيحة؟", "A": "لم تأتِ", "B": "قريش مرّت بثلاث مرات في طلب أبي طالب كف النبي ﷺ", "C": "جاءت مرة واحدة في سياق النص كما يظنّ بعض الدارسين", "D": "جاءت عشر مرات", "c": "B", "pen": 0.25, "exp": "الأولى والثانية والثالثة."}, {"kind": "M", "q": "من قاد المهاجرين في هجرة الحبشة الثانية؟", "A": "جعفر بن أبي طالب", "B": "عمر", "C": "عثمان", "D": "علي", "c": "A", "pen": 0, "exp": "قرأ على النجاشي صدر سورة مريم."}, {"kind": "M", "q": "ما السورة التي قرأها النبي ﷺ على عتبة بن ربيعة؟", "A": "يس", "B": "فصّلت", "C": "الكهف", "D": "الرحمن", "c": "B", "pen": 0, "exp": "حم السجدة."}, {"kind": "N", "q": "أيُّ العبارات الآتية غيرُ صحيحة؟", "A": "عُذّب بلال وصبر", "B": "عُذّب خباب", "C": "عُذّب عمار وأهله", "D": "عُذّب الصحابة ولم يصبروا فارتدوا كلهم", "c": "D", "pen": 0.25, "exp": "صبروا."}, {"kind": "S", "q": "ما الذي دفع النجاشي إلى حماية المهاجرين لما سمع سورة مريم؟", "A": "أراد الحرب", "B": "قال: إن هذا والذي جاء به عيسى ليخرج من مشكاة واحدة", "C": "أخذ الهدايا", "D": "خاف من قريش", "c": "B", "pen": 0, "exp": "عدل وإنصاف."}, {"kind": "N", "q": "أيُّ العبارات الآتية غيرُ صحيحة؟", "A": "الثانية بعد الأولى", "B": "الأولى في السنة الخامسة", "C": "في الثانية جعفر بن أبي طالب", "D": "هجرة الحبشة الثانية كانت قبل الأولى", "c": "D", "pen": 0.25, "exp": "الأولى قبل الثانية."}, {"kind": "S", "q": "حين كُتبت الصحيفة قاطعت قريش:", "A": "الفرس", "B": "اليهود في سياق النص كما يظنّ بعض الدارسين", "C": "الروم", "D": "بني هاشم وبني المطلب في البيع والزواج", "c": "D", "pen": 0, "exp": "حصار."}, {"kind": "M", "q": "من أزالت سلا الجزور عن ظهر النبي ﷺ؟", "A": "عائشة", "B": "خديجة", "C": "ابنته فاطمة رضي الله عنها", "D": "أم سلمة في سياق النص في هذا الموضع", "c": "C", "pen": 0, "exp": "وهي صغيرة."}, {"kind": "N", "q": "أيُّ العبارات الآتية غيرُ صحيحة؟", "A": "أسلم أبو طالب وأعلن إيمانه", "B": "نصر أبو طالب النبي ﷺ", "C": "مات على ملة عبد المطلب بحسب فهم بعضهم", "D": "لم يسلّمه لقريش", "c": "A", "pen": 0.25, "exp": "لم يسلم."}, {"kind": "N", "q": "أيُّ العبارات الآتية صحيحة؟", "A": "طلب وفد قريش من أحبار اليهود ما يمتحنون به النبي ﷺ", "B": "سألوا النصارى فقط بحسب فهم بعضهم كما يظنّ بعض الدارسين", "C": "ذهبوا إلى الروم", "D": "اتبعوا النبي ﷺ", "c": "A", "pen": 0.25, "exp": "الروح والكهف وذو القرنين."}, {"kind": "S", "q": "قال طالب إن أبا جهل أسلم يوم حمزة. صحح:", "A": "هاجر", "B": "لم يسلم أبو جهل", "C": "نصر النبي", "D": "أسلم", "c": "B", "pen": 0, "exp": "مات كافرًا."}, {"kind": "M", "q": "من الذي ألقى سلا الجزور على ظهر النبي ﷺ وهو ساجد عند الكعبة؟", "A": "الوليد بن المغيرة", "B": "أبو جهل", "C": "عقبة بن أبي معيط", "D": "أبو لهب", "c": "C", "pen": 0, "exp": "وأزالته ابنته فاطمة رضي الله عنها."}, {"kind": "M", "q": "بماذا رد أبو طالب على عرض قريش بأخذ عمارة وتسليم محمد ﷺ؟", "A": "قبل العرض بحسب فهم بعضهم في هذا الموضع في هذا الموضع في سياق النص", "B": "سكت", "C": "«لبئس ما تسومونني، أتعطونني ابنكم أغذوه وأعطيكم ابني تقتلونه؟»", "D": "طلب مهلة", "c": "C", "pen": 0, "exp": "رفض