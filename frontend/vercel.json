{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/articles",
      "destination": "/articles"
    }
  ],
  "functions": {
    "api/guide-download.mjs": {
      "includeFiles": "api/_paid/**"
    }
  },
  "redirects": [
    {
      "source": "/buy-guide",
      "destination": "/store",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/(admin|owner|librarian|teacher|academy-admin|academy-tutor|academy-dashboard|skills-admin|skills-tutor|skills-dashboard|tbc-admin|tbc-facilitator|tbc-dashboard|dashboard|my-card|verify|tracker|quiz|exams|exam-teacher)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
