#!/usr/bin/env python3
"""Rebuild out/api/_wa/knowledge.md (the assistant's school information) from the latest prospectus and Student Guide PDFs.

    python3 tools/refresh_knowledge.py <prospectus.pdf> <student-guide.pdf>

Needs `pdftotext` (poppler). The hand-written updates in out/api/_wa/notes.md are NOT touched: they are read separately by the assistant."""
import re, subprocess, sys, pathlib

def text(pdf):
    out = subprocess.run(['pdftotext', '-layout', pdf, '-'], capture_output=True, text=True, check=True).stdout
    return '\n'.join(re.sub(r'[ ]{3,}', '  ', l).rstrip() for l in out.splitlines() if l.strip())

if len(sys.argv) != 3:
    sys.exit(__doc__)
pros, guide = text(sys.argv[1]), text(sys.argv[2])
dest = pathlib.Path(__file__).resolve().parent.parent / 'out' / 'api' / '_wa' / 'knowledge.md'
dest.write_text('# Himaayah Schools knowledge base (generated from the prospectus and the Student Guide)\n\n## PROSPECTUS\n' + pros + '\n\n## STUDENT GUIDE\n' + guide + '\n', encoding='utf-8')
print('wrote', dest, len(dest.read_text(encoding='utf-8')), 'characters')
